# Copie para .env (cp .env.example .env) e preencha os valores obrigatórios.
# O arquivo .env nunca deve ser commitado. Este arquivo é lido pelo Docker Compose
# (interpolação) e pelo Django/uv no host. Valores sem padrão (vazios) são obrigatórios.
# Gere segredos com:  openssl rand -hex 24
# Use apenas caracteres seguros para URL (letras e números) nas senhas, pois entram em DATABASE_URL.

# --- Django ---
DJANGO_SECRET_KEY=
DJANGO_DEBUG=true
# Para o Compose, "backend" é acrescentado automaticamente (proxy do frontend).
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_LOG_LEVEL=INFO
# Opcional: caminho (relativo à raiz do backend) de um fixture carregado na subida do contêiner.
# SEED_FIXTURE=fixtures/seed.json

# --- PostgreSQL (serviço db) ---
POSTGRES_DB=sigtcc
POSTGRES_USER=sigtcc
POSTGRES_PASSWORD=
# Porta publicada em 127.0.0.1 (usada por "uv run pytest" e ferramentas no host).
POSTGRES_HOST_PORT=5432
# Usada SOMENTE no host (uv run). No Compose a URL é montada com as variáveis POSTGRES_*
# e o host "db". Repita aqui a mesma senha de POSTGRES_PASSWORD.
DATABASE_URL=postgres://sigtcc:SENHA@127.0.0.1:5432/sigtcc

# --- RustFS (armazenamento S3-compatível, ADR backend 0002) ---
# Credenciais próprias. Não use as padrão do RustFS. Access key >= 3 caracteres e secret >= 8.
RUSTFS_ACCESS_KEY=
RUSTFS_SECRET_KEY=
# Bucket usado pelo script de fumaça (a aplicação criará o seu na issue #49).
S3_BUCKET=sigtcc-dev

# --- Frontend ---
# Pasta do clone do sigtcc-frontend, contexto de build e bind mount do serviço frontend.
FRONTEND_CONTEXT=../sigtcc-frontend

# --- Definidas pelo próprio compose.yaml (não precisam constar no .env) ---
# MAILPIT_API_URL=http://mailpit:8025,
# AWS_S3_ENDPOINT_URL=http://rustfs:9000, AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY (= RUSTFS_*),
# AWS_S3_REGION_NAME=us-east-1, DEV_PROXY_TARGET=http://backend:8000 e VITE_API_BASE_URL=/api.
# Portas no host (127.0.0.1): backend 8000, frontend 3000, RustFS 9000/9001, Mailpit 8025.

# --- Sessão (ADR backend 0001) ---
# Access token de curta duração; o refresh token (cookie httpOnly) expira após este tempo sem uso.
JWT_ACCESS_MINUTES=5
JWT_REFRESH_MINUTES=30
# Em desenvolvimento por HTTP use false; em qualquer outro ambiente deixe true (padrão).
JWT_REFRESH_COOKIE_SECURE=false
# Origens do frontend autorizadas a chamar login, refresh e logout (separadas por vírgula).
JWT_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Recuperação de senha (RF07) ---
# Endereço do frontend usado no link enviado por e-mail (o link vale 1 hora e só pode ser usado uma vez).
FRONTEND_URL=http://localhost:3000
# Padrão do Compose: Mailpit (caixa em http://localhost:8025). Para a demonstração com um SMTP real,
# descomente e preencha (a senha fica só no .env, nunca no git).
# EMAIL_HOST=smtp.exemplo.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=true
